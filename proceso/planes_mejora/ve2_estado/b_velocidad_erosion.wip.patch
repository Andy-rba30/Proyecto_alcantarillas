+# ===========================================================================
+# 4 · El mutante que vuelve a la formula vieja muere
+# ===========================================================================
+
+# El texto de la correccion en `resolver_manning` y el de la formula vieja.
+# El mutante sustituye el primero por el segundo en una COPIA del modulo,
+# cargada aparte: el arbol de trabajo no se toca.
+EXPRESION_CORREGIDA = "V_erosion=Q / geom_erosion.A"
+EXPRESION_VIEJA = ("V_erosion=factor_geometrico / "
+                   "material.n_para_velocidad_maxima")
+
+
+def _modulo_mutado(tmp_path):
+    fuente = FUENTE_M3.read_text(encoding="utf-8")
+    assert fuente.count(EXPRESION_CORREGIDA) == 1, (
+        "la correccion de VE-2 no esta en resolver_manning con el texto que "
+        "el mutante espera")
+    ruta = tmp_path / "M3_mutado_ve2.py"
+    ruta.write_text(fuente.replace(EXPRESION_CORREGIDA, EXPRESION_VIEJA),
+                    encoding="utf-8")
+    spec = importlib.util.spec_from_file_location("M3_mutado_ve2", ruta)
+    modulo = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(modulo)
+    return modulo
+
+
+@ROJO_VE2
+@pytest.mark.parametrize("seccion", [SeccionCircular(0.90),
+                                     SeccionRectangular(2.00, 1.50)],
+                         ids=["circular", "marco"])
+def test_el_mutante_de_la_formula_vieja_muere(tmp_path, marco, seccion):
+    material = (catalogo(CONCRETO) if isinstance(seccion, SeccionCircular)
+                else marco)
+    S = 0.01
+    Q = 0.5 * _Q_lleno(seccion, material.n_para_capacidad, S)
+    # El original pasa la comprobacion...
+    _continuidad(M3.resolver_manning(seccion, Q, S, material),
+                 seccion, Q, S, material)
+    # ...y el mutante no: V * A(n_min) se aparta de Q mucho mas que la
+    # tolerancia (medido: un 4.8 % como minimo en la malla).
+    mutado = _modulo_mutado(tmp_path).resolver_manning(seccion, Q, S, material)
+    with pytest.raises(AssertionError):
+        _continuidad(mutado, seccion, Q, S, material)
+
