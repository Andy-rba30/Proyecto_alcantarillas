+def _ficha(nombre: str) -> str:
+    texto = REGISTRO.read_text(encoding="utf-8")
+    inicio = texto.index(f"\n## {nombre} · ")
+    fin = texto.find("\n## ", inicio + 1)
+    return texto[inicio:fin if fin != -1 else len(texto)]
