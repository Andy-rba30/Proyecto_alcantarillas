+
+def _segmento(D: float, h: float) -> float:
+    """Area de un circulo de diametro D bajo una cuerda a altura h."""
+    theta = 2 * math.acos(1 - 2 * h / D)
+    return (D ** 2 / 8) * (theta - math.sin(theta))
+
