+NIVEL_V7_EN_LA_CLAVE = "en_la_clave"
+NIVEL_V7_NF_DEL_PUNTO = "nf_del_punto"
+NIVELES_AGUA_V7 = (NIVEL_V7_EN_LA_CLAVE, NIVEL_V7_NF_DEL_PUNTO)
