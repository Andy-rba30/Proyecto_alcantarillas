+        formula_cita_id="MC_HHD.3.12.2.1#K",
+        citas_textuales=("MC_HHD.3.12.2.1#K", "MC_HHD.3.12.2#AREA",
+                         "MC_HHD.3.12.3.2a#AREA", "MC_HHD.3.12.3.2b#AREA",
+                         "MC_HHD.3.12.4"),
+        sustitucion=(
+            Magnitud("C", C, "", f"paso {CODIGO_C}", cifras=CIFRAS_MAGNITUD),
