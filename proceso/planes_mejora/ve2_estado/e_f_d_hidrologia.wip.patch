+            Pd_mag,
+            Magnitud("P", P, "mm", "precipitacion maxima corregida sobre la "
+                     "cuenca, ecuacion (33)", cifras=CIFRAS_MAGNITUD),
+            Tc_mag),
+        resultado=Magnitud("I", I, "mm/h", "intensidad de diseño, ecuacion "
