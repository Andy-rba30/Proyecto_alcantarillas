+    assert MH.CODIGO_CONSISTENCIA in [p.codigo for p in c.pasos]
+    declarado = MH.caudal_declarado(Q_m3s=1.0, de_donde="columna Q_m3s",
+                                    area_km2=2.1, origen_area="prueba")
